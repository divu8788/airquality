[Unit]
Description=Air Quality Health Risk Prediction
After=network.target mysql.service

[Service]
User=gipra
WorkingDirectory=/home/gipra/airquality
EnvironmentFile=/home/gipra/airquality/.env
ExecStart=/home/gipra/airquality/venv/bin/gunicorn \
    --workers 3 \
    --bind 0.0.0.0:8080 \
    --timeout 120 \
    run:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
